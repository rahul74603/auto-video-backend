# Copy to ai_backend/.env for local development only. Never commit real values.

# Required by all generative AI agents
GEMINI_API_KEY=
AI_PROMPT_MODEL=gemini-2.5-flash-lite
AI_AGENT_MODEL=gemini-2.5-flash
AI_PROMPT_ENHANCEMENT_ENABLED=true
AI_AGENT_MAX_OUTPUT_TOKENS=8192

# Required to protect POST /agents/* and POST /seo/indexing-audit.
# It may also authenticate trusted server-to-server /articles/* calls.
# Generate with: openssl rand -hex 32
#AGENT_ADMIN_TOKEN=

# /articles/* browser access: comma-separated Firebase Auth admin emails.
# A Firebase user with custom claim admin=true is also accepted.
ARTICLE_ADMIN_EMAILS=

# Adaptive Article Studio quality fallback (bounded to 1..3 / <=270 seconds).
AI_ARTICLE_STRATEGIES=3
AI_ARTICLE_BUDGET_MS=225000

# Firebase Admin + Google Search Console/Indexing API service-account JSON
# Put the complete one-line JSON object here.
SERVICE_ACCOUNT_JSON=

# SEO Intelligence (lifecycle/gaps/CTR) needs no new secrets.
# Optional: paste Search Console analytics JSON in Admin → SEO tab.
# Existing SERVICE_ACCOUNT_JSON is reused by SEO Master / Indexing Agent only.

# SEO/Indexing Agent (non-secret settings)
WEBSITE_URL=https://studygyaan.in
SITEMAP_URL=https://studygyaan.in/sitemap.xml
SEARCH_CONSOLE_SITE_URL=sc-domain:studygyaan.in
SEARCH_CONSOLE_INSPECTION_ENABLED=true
SEARCH_CONSOLE_SITEMAP_SUBMIT_ENABLED=true
SEO_AGENT_MAX_URLS=200
SEO_INSPECTION_LIMIT=25
SEO_AUDIT_CONCURRENCY=5
SEO_AUDIT_TIMEOUT_MS=15000
INDEXING_API_ENABLED=true
INDEXING_DAILY_LIMIT=180

# Existing optional notification and publishing integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_LINK=
TELEGRAM_CHANNEL_NAME=
GMAIL_CREDENTIALS=
YOUTUBE_TOKEN=
YOUTUBE_TOKEN_SELF_TEST=
PAYMENT_GMAIL_TOKEN=
TTS_KEY_JSON=
FB_PAGE_ID=
FB_PAGE_TOKEN=
GH_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
RSS_SECRET_TOKEN=

# ============================================================
# 🚀 NEW — Social Media Automation (Twitter/X + LinkedIn + Instagram + YouTube)
# Just add keys here AND in GitHub Secrets — system auto-starts, no code change needed
# ============================================================

# --- Facebook (already exists, improved) ---
# FB_PAGE_ID= (Page ID from facebook.com/yourpage -> About -> Page ID)
# FB_PAGE_TOKEN= (Long-lived Page Token from developers.facebook.com)

# --- Twitter / X (for auto posting jobs/blogs) ---
# How to get: developer.twitter.com -> Create Project & App -> Keys and Tokens
# Permissions: Read and Write
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Optional (OAuth 2.0 Bearer, for reading)
TWITTER_BEARER_TOKEN=
# Optional client credentials
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LinkedIn (Company Page or Personal) ---
# How to get: developer.linkedin.com -> Create App -> Products: Share on LinkedIn + Marketing Developer Platform
# OAuth 2.0 flow to get token (valid 60 days)
LINKEDIN_ACCESS_TOKEN=
# For Company Page posting (recommended):
LINKEDIN_ORGANIZATION_ID=urn:li:organization:123456789
# OR for personal profile posting:
LINKEDIN_PERSON_ID=urn:li:person:xxxxxx
# Optional for refresh:
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Instagram (via Facebook) ---
# Requires FB Page linked to Instagram Business Account
# How to get IG User ID: Graph API Explorer -> GET /{page-id}?fields=instagram_business_account
INSTAGRAM_ACCOUNT_ID=
# FB_PAGE_TOKEN is reused for Instagram

# --- YouTube Community + Video (optional) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Automation Control ---
# These are checked by social_orchestrator — respects Pause All from Admin Panel
# No need to set, just ensure system_settings/automation doc exists in Firestore (auto-created)

# ============================================================
# GitHub Secrets (add same keys in GitHub repo Settings -> Secrets and variables -> Actions):
# SERVICE_ACCOUNT_JSON, FIREBASE_SERVICE_ACCOUNT, GEMINI_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
# FB_PAGE_ID, FB_PAGE_TOKEN, TWITTER_API_KEY, TWITTER_API_SECRET, TWITTER_ACCESS_TOKEN, TWITTER_ACCESS_SECRET,
# TWITTER_BEARER_TOKEN, LINKEDIN_ACCESS_TOKEN, LINKEDIN_ORGANIZATION_ID, LINKEDIN_PERSON_ID,
# INSTAGRAM_ACCOUNT_ID, YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET, YOUTUBE_REFRESH_TOKEN, GH_TOKEN, GITHUB_OWNER, GITHUB_REPO
# ============================================================


# ============================================================
# 🧠 Growth Engine — AI Self-Improving Video Platform
# ============================================================
# All features have safe defaults. Uncomment to override.
# Feature flags: true/false (default shown after =)

# --- Master Switches ---
# GROWTH_ENGINE_ENABLED=true
# ANALYTICS_ENABLED=true
# AB_TESTING_ENABLED=false
# TREND_ENGINE_ENABLED=false
# BREAKING_MODE_ENABLED=true
# COMMENT_INTELLIGENCE_ENABLED=false

# --- Sub-System Flags ---
# HOOK_ENGINE_ENABLED=true
# SCRIPT_ENGINE_ENABLED=true
# QUALITY_GATE_ENABLED=true
# VISUAL_ENGINE_ENABLED=true
# MUSIC_ENGINE_ENABLED=true
# PRESENTER_ROTATION_ENABLED=true
# FIRST_FRAME_ENABLED=true
# SUBTITLE_ENGINE_ENABLED=true
# CONTENT_MUTATION_ENABLED=false
# REACH_PREDICTION_ENABLED=true
# LEARNER_ENABLED=true
# RECOMMENDATION_ENGINE_ENABLED=true
# DUPLICATE_DETECTION_ENABLED=true
# CONTENT_CLUSTERING_ENABLED=true

# --- Video Pipeline Tuning ---
# VIDEO_DAILY_LIMIT=5         (YouTube quota — default 5/day)
# VIDEO_MAX_AGE_DAYS=1        (only render content published within last N days)
# VIDEO_SHORTS_CUTOFF=        (ISO date — no shorts before this date)
# VIDEO_PRIVACY_STATUS=       (blank=public, 'unlisted'=safe testing)
# TTS_ENGINE=edge             (force Edge TTS, skip Google attempt)

# --- Firestore Collections (auto-created, no config needed) ---
# content_opportunities    — detected content opportunities
# content_performance      — platform metrics (views, likes, retention...)
# content_fingerprints     — duplicate detection fingerprints
# growth_insights          — learned patterns from analytics
# growth_experiments       — A/B test tracking
# growth_recommendations   — AI-generated recommendations
# platform_posts           — per-platform upload state

# --- No Additional Secrets Required ---
# Growth engine uses existing SERVICE_ACCOUNT_JSON for Firestore access.
# Analytics collection uses existing YOUTUBE_TOKEN, FB_PAGE_TOKEN, TELEGRAM_BOT_TOKEN.
# All external API calls are optional — missing credentials = graceful skip.
