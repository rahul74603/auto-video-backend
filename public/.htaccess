# ==============================================================
# StudyGyaan.in — cPanel public_html/.htaccess
# Health-Score Fix Pack (Ahrefs Site Audit friendly)
# --------------------------------------------------------------
# Kya karta hai:
#   1. Canonical host force karta hai (https + non-www, Cloudflare-safe)
#   2. Purana sitemap-all.xml → sitemap.xml 301 (duplicate-sitemap fix)
#   3. Missing assets (js/css/images) ko HARD 404 deta hai —
#      kabhi bhi SPA ka index.html JavaScript/CSS ki jagah serve nahi hota
#      (yehi "Page has broken JavaScript" ka #1 cause hai)
#   4. SEO meta data files (seo-meta-*.json) ko public access se block karta hai
#   5. SAB crawlers/bots (Googlebot, Bingbot, AhrefsSiteAudit, Semrush,
#      WhatsApp/FB/Telegram previews...) ko meta.php pe bhejta hai —
#      clean static HTML with correct title/description/canonical per URL
#   6. Normal users ko React SPA deta hai — deep links pe bhi 404 nahi
#   7. Compression + caching (slow page warnings kam karta hai)
# ==============================================================

DirectoryIndex index.html index.php
Options -Indexes

RewriteEngine On
RewriteBase /

# ---------- 1) Canonical host: https + non-www ----------
# Cloudflare-safe: redirect sirf tab jab origin pe http ho aur
# Cloudflare ka X-Forwarded-Proto: https header na aaye
# (warna Flexible SSL me infinite redirect loop lag sakta hai)
RewriteCond %{HTTPS} =off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://studygyaan.in%{REQUEST_URI} [R=301,L,NE]

# www → apex (host-based hai isliye loop kabhi nahi ban sakta)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://studygyaan.in%{REQUEST_URI} [R=301,L,NE]

# ---------- 2) Purana monolithic sitemap → sitemap index ----------
# (robots.txt me ab sirf sitemap.xml hai; "page in multiple sitemaps" fix)
RewriteRule ^sitemap-all\.xml$ /sitemap.xml [R=301,L]

# ---------- 3) Missing static assets → HARD 404 ----------
# Rule: jo asset file exist nahi karti wo 404 hogi — SPA ka HTML
# uski jagah KABHI serve nahi hoga. Iske bina browser JS ki jagah
# HTML parse karta hai → har page pe "broken JavaScript".
# (Existing files normally serve hoti hain)
RewriteRule \.(js|mjs|css|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|ogg|mp3|pdf|wasm|zip|xml|txt|json)$ - [L,NC]

# ---------- 4) SEO data files ko direct access block ----------
<FilesMatch "^(seo-meta-.+\.json|_urls\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------- 5) SAB BOTS → meta.php (dynamic rendering) ----------
# Bot = UA me inme se kuch bhi ho. Existing FILES (robots.txt,
# sitemap-*.xml, images, rss.xml...) skip hoti hain — wo seedhi milti hain.
# NOTE: AhrefsSiteAudit UA me "bot" word nahi hota — isliye explicit hai.
RewriteCond %{REQUEST_URI} !^/meta\.php$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{HTTP_USER_AGENT} (ahrefs|semrush|mj12|petalbot|applebot|googlebot|bingbot|yandex|duckduck|baiduspider|sogou|yeti|facebookexternalhit|whatsapp|telegram|twitterbot|linkedin|discord|pinterest|slackbot|instagram|embedly|quora|skype|bot|crawl|spider|slurp|headlesschrome|lighthouse|pagespeed|gtmetrix|pingdom|uptimerobot|validator|wget|curl|python|scrapy|okhttp|libwww) [NC]
RewriteRule ^ /meta.php [L]

# ---------- 6) Humans → React SPA fallback ----------
# Deep links (/job/xyz, /blog/abc...) directly kholne pe bhi app chalegi
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/meta\.php$
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteRule ^ /index.html [L]

# ---------- 7) Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# ---------- 8) Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType application/pdf "access plus 30 days"
</IfModule>

# index.html / service worker / manifest hamesha fresh milne chahiye
# (naya deploy turant users ko dikhe)
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|OneSignalSDKWorker\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
