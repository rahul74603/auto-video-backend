# ============================================
# StudyGyaan — Frontend Env (Local Dev)
# .env.local naam ki file banao project root me
# aur ye values bharo. (.env.local git me commit NAHI hoti)
# ============================================

# --- Admin Login ---
VITE_ADMIN_EMAIL=

# --- AI Article Agent (JOBS AI tab) ---
# KOI TOKEN NAHI CHAHIYE — admin panel Gmail login ke peeche protected hai.
# Frontend sirf deployed api function ko call karta hai.

# --- Manual Payment page ---
VITE_UPI_ID=
VITE_QR_CODE_URL=

# --- EmailJS (order approval emails) ---
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
