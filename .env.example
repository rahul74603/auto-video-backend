# ============================================
# StudyGyaan — Frontend Env (Local Dev)
# .env.local naam ki file banao project root me
# aur ye values bharo. (.env.local git me commit NAHI hoti)
# ============================================

# --- Admin Login ---
VITE_ADMIN_EMAIL=

# --- AI Article Agent (JOBS AI tab) ---
# Deployed backend function ka wahi secret jo Google Cloud Secret Manager
# me AGENT_ADMIN_TOKEN ke naam se save hai.
# Value pata karne ke liye:
#   gcloud secrets versions access latest --secret=AGENT_ADMIN_TOKEN
# (ya Firebase Console → Functions → configuration)
# Naya set karna ho to:
#   cd ai_backend && npx firebase-tools functions:secrets:set AGENT_ADMIN_TOKEN
VITE_AGENT_ADMIN_TOKEN=

# --- Manual Payment page ---
VITE_UPI_ID=
VITE_QR_CODE_URL=

# --- EmailJS (order approval emails) ---
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
